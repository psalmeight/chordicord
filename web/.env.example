VITE_API_URL=http://localhost:8082

# Auth0 Single Page Application for this web app, plus the API identifier
# (audience) the Go API validates tokens against. Filled in by the Auth0
# onboarding step.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://chordicord-api
