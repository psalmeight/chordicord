# Same API as the songbook web app; the prayer routes live under /api/prayer.
# Add this app's origin (e.g. http://localhost:5174) to the API's WEB_URL.
VITE_API_URL=http://localhost:8082

# Same Auth0 tenant and API audience as web/, so one account and one role
# work in both apps. Reusing web's SPA client id is fine as long as this
# app's origin is added to its callback, logout and web origin lists.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://chordicord-api
