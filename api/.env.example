# Postgres connection string (Supabase, Neon, or local).
DATABASE_URL=postgresql://user:password@localhost:5432/transcode

# Signing secret for session and invite tokens. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# Comma-separated list of allowed CORS origins. The first is used to build
# invite links.
WEB_URL=http://localhost:5173

PORT=8082

# --- Song reference tracks (optional) ---------------------------------------
# Supabase Storage holds the MP3s. Leave these blank and the audio endpoints
# report "not configured"; everything else still works.
#
# Create a PRIVATE bucket named song-audio. It must stay private — playback
# goes through short-lived signed URLs, and a public bucket would make every
# uploaded recording a permanent open link.
SUPABASE_URL=https://your-project.supabase.co
# Service role key (Settings > API). Server-side only — never expose to the web app.
SUPABASE_SERVICE_KEY=
SUPABASE_AUDIO_BUCKET=song-audio

# How many songs may have an MP3 attached at once.
MAX_AUDIO_UPLOADS=30
